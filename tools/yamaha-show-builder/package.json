{
  "name": "yamaha-show-builder",
  "version": "3.4.0",
  "private": true,
  "type": "module",
  "description": "Build a labelled, routed show on a Yamaha digital desk from a web page",
  "scripts": {
    "start": "node server.js",
    "mock": "node mock-desk.js",
    "test": "node --test test/*.test.js",
    "format": "npx prettier@3.3.3 --write \"**/*.{js,mjs,css}\"",
    "format:check": "npx prettier@3.3.3 --check \"**/*.{js,mjs,css}\""
  },
  "engines": {
    "node": ">=18"
  }
}
