# Copy to .env and fill in. Never commit the real .env file.
# These are read by app.config.ts via process.env at build time.

# Supabase project (Settings > API in the Supabase dashboard)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# RevenueCat public SDK keys (RevenueCat dashboard > Project > API keys)
REVENUECAT_API_KEY_IOS=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_API_KEY_ANDROID=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx
REVENUECAT_ENTITLEMENT_ID=subscriber

# Base ad tag URL for Google Ad Manager (VAST/VMAP). The film's individual
# ad break config is stored in the `films` table and appended to this.
AD_TAG_URL_BASE=https://pubads.g.doubleclick.net/gampad/ads

# --- Server-side only: set these as Supabase Edge Function secrets, NOT here ---
# supabase secrets set MUX_TOKEN_ID=... MUX_TOKEN_SECRET=... MUX_WEBHOOK_SIGNING_SECRET=...
# supabase secrets set REVENUECAT_WEBHOOK_AUTH_HEADER=...
